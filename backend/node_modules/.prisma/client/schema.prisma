datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// AUTH & USERS
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("STUDENT") // STUDENT, TEACHER, HOD, ADMIN, SUPER_ADMIN
  fullName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student   Student?
  teacher   Teacher?
  auditLogs AuditLog[]
  notices   Notice[]
}

// ----------------------------------------------------
// ACADEMIC HIERARCHY
// ----------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  programs Program[]
  teachers Teacher[]
  students Student[]
}

model Program {
  id            String     @id @default(uuid())
  code          String     @unique
  name          String
  durationYears Int        @default(4)
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())

  batches  Batch[]
  subjects Subject[]
  students Student[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String   @unique // e.g. "2026-2027"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())

  semesters Semester[]
}

model Batch {
  id        String   @id @default(uuid())
  name      String // e.g. "2024-2028"
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  startYear Int
  endYear   Int
  createdAt DateTime @default(now())

  semesters Semester[]
  students  Student[]
}

model Semester {
  id             String       @id @default(uuid())
  number         Int // 1 to 8
  batchId        String
  batch          Batch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  isCurrent      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  sections Section[]
  students Student[]
  results  Result[]
}

model Section {
  id         String   @id @default(uuid())
  name       String // e.g. "A", "B"
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  capacity   Int      @default(60)
  createdAt  DateTime @default(now())

  students            Student[]
  teachingAssignments TeachingAssignment[]
  timetable           TimetableEntry[]
  attendanceSessions  AttendanceSession[]
  assignments         Assignment[]
}

// ----------------------------------------------------
// PROFILES
// ----------------------------------------------------

model Student {
  id               String     @id @default(uuid())
  userId           String     @unique
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNumber String     @unique
  rollNumber       String     @unique
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id])
  programId        String
  program          Program    @relation(fields: [programId], references: [id])
  batchId          String
  batch            Batch      @relation(fields: [batchId], references: [id])
  semesterId       String
  semester         Semester   @relation(fields: [semesterId], references: [id])
  sectionId        String
  section          Section    @relation(fields: [sectionId], references: [id])
  cgpa             Float      @default(0.0)
  guardianName     String?
  guardianPhone    String?
  hostelRoom       String?
  createdAt        DateTime   @default(now())

  attendanceRecords     AttendanceRecord[]
  assignmentSubmissions AssignmentSubmission[]
  eventRegistrations    EventRegistration[]
  complaints            HostelComplaint[]
  results               Result[]
  libraryTransactions   LibraryTransaction[]
  fees                  StudentFee[]
}

model Teacher {
  id            String     @id @default(uuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeId    String     @unique
  departmentId  String
  department    Department @relation(fields: [departmentId], references: [id])
  designation   String // Professor, Assistant Professor, etc.
  qualification String // Ph.D, M.Tech, etc.
  createdAt     DateTime   @default(now())

  teachingAssignments TeachingAssignment[]
  attendanceSessions  AttendanceSession[]
  timetable           TimetableEntry[]
  assignments         Assignment[]
  studyMaterials      StudyMaterial[]
}

// ----------------------------------------------------
// SUBJECTS & TEACHING ASSIGNMENTS
// ----------------------------------------------------

model Subject {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. "BCS501"
  name           String // e.g. "Database Management Systems"
  credits        Int      @default(4)
  type           String   @default("THEORY") // THEORY, PRACTICAL, ELECTIVE
  programId      String
  program        Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  semesterNumber Int      @default(1)
  createdAt      DateTime @default(now())

  teachingAssignments TeachingAssignment[]
  timetable           TimetableEntry[]
  attendanceSessions  AttendanceSession[]
  assignments         Assignment[]
  studyMaterials      StudyMaterial[]
  syllabusUnits       SyllabusUnit[]
  resultItems         ResultItem[]
}

model TeachingAssignment {
  id        String   @id @default(uuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teacherId, subjectId, sectionId])
}

// ----------------------------------------------------
// TIMETABLE
// ----------------------------------------------------

model TimetableEntry {
  id        String   @id @default(uuid())
  dayOfWeek String // MONDAY, TUESDAY, WEDNESDAY, THURSDAY, FRIDAY, SATURDAY
  startTime String // "09:00"
  endTime   String // "10:00"
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  roomName  String // e.g. "LT-101", "Lab-2"
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// ATTENDANCE
// ----------------------------------------------------

model AttendanceSession {
  id        String   @id @default(uuid())
  date      String // "YYYY-MM-DD"
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId String
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic     String?
  createdAt DateTime @default(now())

  records AttendanceRecord[]
}

model AttendanceRecord {
  id        String            @id @default(uuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  isPresent Boolean           @default(true)
  remarks   String?
  createdAt DateTime          @default(now())

  @@unique([sessionId, studentId])
}

// ----------------------------------------------------
// ACADEMIC RESOURCES (Syllabus, Materials, Assignments)
// ----------------------------------------------------

model SyllabusUnit {
  id         String   @id @default(uuid())
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  unitNumber Int
  title      String
  topics     String // JSON or text list of topics
  createdAt  DateTime @default(now())
}

model StudyMaterial {
  id          String   @id @default(uuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileUrl     String
  fileType    String   @default("PDF")
  unitNumber  Int?
  createdAt   DateTime @default(now())
}

model Assignment {
  id            String   @id @default(uuid())
  title         String
  description   String
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  dueDate       String // ISO or YYYY-MM-DD
  maxMarks      Int      @default(100)
  attachmentUrl String?
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  submittedAt  DateTime   @default(now())
  status       String     @default("SUBMITTED") // SUBMITTED, LATE, GRADED
  marks        Int?
  feedback     String?

  @@unique([assignmentId, studentId])
}

// ----------------------------------------------------
// RESULTS
// ----------------------------------------------------

model Result {
  id          String   @id @default(uuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semesterId  String
  semester    Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  sgpa        Float    @default(0.0)
  cgpa        Float    @default(0.0)
  status      String   @default("PASSED") // PASSED, PROMOTED, FAILED
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  items ResultItem[]

  @@unique([studentId, semesterId])
}

model ResultItem {
  id            String  @id @default(uuid())
  resultId      String
  result        Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subjectId     String
  subject       Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  internalMarks Float
  externalMarks Float
  totalMarks    Float
  grade         String // A+, A, B+, B, C, F
  gradePoints   Float
}

// ----------------------------------------------------
// NOTICES & EVENTS
// ----------------------------------------------------

model Notice {
  id             String   @id @default(uuid())
  title          String
  content        String
  category       String   @default("GENERAL") // ACADEMIC, EXAMINATION, EVENT, HOSTEL, GENERAL, URGENT
  priority       String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  targetAudience String   @default("ALL") // ALL, STUDENTS, TEACHERS, DEPARTMENT
  departmentId   String?
  attachmentUrl  String?
  publishDate    DateTime @default(now())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id])
  createdAt      DateTime @default(now())
}

model Event {
  id              String   @id @default(uuid())
  title           String
  description     String
  category        String   @default("CULTURAL")
  venue           String
  date            String // YYYY-MM-DD
  startTime       String // HH:MM
  endTime         String // HH:MM
  maxParticipants Int?
  posterUrl       String?
  isPublished     Boolean  @default(true)
  createdAt       DateTime @default(now())

  registrations EventRegistration[]
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  registeredAt DateTime @default(now())

  @@unique([eventId, studentId])
}

// ----------------------------------------------------
// HOSTEL & MESS
// ----------------------------------------------------

model HostelRoom {
  id         String   @id @default(uuid())
  hostelName String // "Aryabhata Hostel", "Kalpana Chawla Hostel"
  building   String
  roomNumber String
  floor      Int
  capacity   Int      @default(2)
  occupied   Int      @default(0)
  createdAt  DateTime @default(now())
}

model HostelComplaint {
  id          String    @id @default(uuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  roomNumber  String
  category    String // ELECTRICAL, PLUMBING, CARPENTRY, CLEANLINESS, OTHER
  description String
  status      String    @default("PENDING") // PENDING, ASSIGNED, IN_PROGRESS, RESOLVED, REJECTED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model MessMenu {
  id          String   @id @default(uuid())
  dayOfWeek   String   @unique // MONDAY, TUESDAY, etc.
  breakfast   String
  lunch       String
  dinner      String
  specialMeal String?
  updatedAt   DateTime @updatedAt
}

// ----------------------------------------------------
// LIBRARY & FEES
// ----------------------------------------------------

model LibraryBook {
  id              String   @id @default(uuid())
  title           String
  author          String
  isbn            String   @unique
  category        String
  totalCopies     Int      @default(5)
  availableCopies Int      @default(5)
  createdAt       DateTime @default(now())

  transactions LibraryTransaction[]
}

model LibraryTransaction {
  id         String      @id @default(uuid())
  bookId     String
  book       LibraryBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  issuedAt   DateTime    @default(now())
  dueDate    DateTime
  returnedAt DateTime?
  fineAmount Float       @default(0.0)
}

model StudentFee {
  id            String   @id @default(uuid())
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear  String
  totalAmount   Float
  paidAmount    Float    @default(0.0)
  pendingAmount Float
  status        String   @default("PENDING") // PAID, PARTIAL, PENDING
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------
// AUDIT LOG
// ----------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // e.g. "STUDENT_CREATED", "ATTENDANCE_RECORDED"
  entityType String // e.g. "Student", "AttendanceSession"
  entityId   String?
  details    String? // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())
}
