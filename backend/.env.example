# ==========================================
# VGI CAMPUS Backend Environment Variables
# ==========================================

# Server Port & Mode
PORT=5050
NODE_ENV=development

# Database Connection (SQLite local file by default)
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET="vgi-campus-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins
CORS_ORIGIN="*"
